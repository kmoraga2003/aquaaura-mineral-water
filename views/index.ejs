                    <a href="#">Términos & Condiciones</a>
                    <a href="#">Política de Privacidad</a>
                    <a href="#">Análisis de Laboratorio PDF</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Cart Drawer Modal -->
    <div class="cart-drawer-overlay" id="cartOverlay"></div>
    <div class="cart-drawer" id="cartDrawer">
        <div class="cart-header">
            <h3><i data-lucide="shopping-bag"></i> Tu Carrito AquaAura</h3>
            <button class="cart-close-btn" id="cartClose"><i data-lucide="x"></i></button>
        </div>
        <div class="cart-body" id="cartBody">
            <div class="cart-empty" id="cartEmpty">
                <div class="empty-icon"><i data-lucide="droplet"></i></div>
                <p>Tu carrito está vacío</p>
                <span>Explora nuestra selección de aguas minerales y añade tus preferidas.</span>
            </div>
            <div class="cart-items-list" id="cartItemsList"></div>
        </div>
        <div class="cart-footer" id="cartFooter">
            <div class="promo-box">
                <input type="text" id="promoInput" placeholder="Código de descuento (ej: MANANTIAL10)">
                <button id="promoBtn">Aplicar</button>
            </div>
            <div class="cart-summary">
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span id="cartSubtotal">$0</span>
                </div>
                <div class="summary-row discount-row" id="discountRow" style="display: none;">
                    <span>Descuento Aplicado</span>
                    <span id="cartDiscount" class="text-green">-$0</span>
                </div>
                <div class="summary-row">
                    <span>Despacho a Domicilio</span>
                    <span class="text-free">GRATIS</span>
                </div>
                <div class="summary-row total-row">
                    <span>Total</span>
                    <span id="cartTotal">$0</span>
                </div>
            </div>
            <button class="btn btn-primary btn-block btn-lg" id="checkoutBtn">Proceder al Pago & Checkout</button>
        </div>
    </div>

    <!-- Checkout Modal -->
    <div class="modal-overlay" id="checkoutModalOverlay">
        <div class="modal-card">
            <button class="modal-close" id="checkoutClose"><i data-lucide="x"></i></button>
            <div class="modal-header">
                <h2>Finalizar Pedido de Agua Mineral</h2>
                <p>Ingresa tus datos para despachar a tu domicilio</p>
            </div>
            <form id="orderForm" class="checkout-form">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="custName"><i data-lucide="user"></i> Nombre Completo *</label>
                        <input type="text" id="custName" required placeholder="Ej: Valentina Morales">
                    </div>
                    <div class="form-group">
                        <label for="custEmail"><i data-lucide="mail"></i> Correo Electrónico *</label>
                        <input type="email" id="custEmail" required placeholder="ejemplo@correo.cl">
                    </div>
                    <div class="form-group">
                        <label for="custPhone"><i data-lucide="phone"></i> Teléfono Móvil *</label>
                        <input type="tel" id="custPhone" required placeholder="+56 9 1234 5678">
                    </div>
                    <div class="form-group">
                        <label for="orderType"><i data-lucide="repeat"></i> Modalidad de Pedido</label>
                        <select id="orderType">
                            <option value="one_time">Compra Única</option>
                            <option value="subscription">Suscripción Programada (-15%)</option>
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label for="custAddress"><i data-lucide="map-pin"></i> Dirección de Despacho *</label>
                        <textarea id="custAddress" required rows="2" placeholder="Av. Las Condes 1234, Dpto 501, Santiago"></textarea>
                    </div>
                </div>

                <div class="checkout-summary-mini">
                    <span>Total a pagar: <strong id="checkoutTotalText">$0</strong></span>
                    <span class="pay-note"><i data-lucide="lock"></i> Pago seguro a la entrega o transferencia instantánea</span>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg" id="submitOrderBtn">
                    <span>Confirmar Pedido & Embotellar</span>
                    <i data-lucide="arrow-right"></i>
                </button>
            </form>
            
            <!-- Order Success View -->
            <div class="order-success-view" id="orderSuccessView" style="display: none;">
                <div class="success-icon-animated">
                    <i data-lucide="check-circle-2"></i>
                </div>
                <h3>¡Pedido Confirmado con Éxito!</h3>
                <p class="order-id-badge">Número de Orden: <strong id="successOrderNum">#AQ-8912</strong></p>
                <p class="success-desc">Gracias <span id="successCustName"></span>. Hemos recibido tu pedido por <strong id="successTotal"></strong>. El lote está ingresando a nuestra línea de embotellado sostenible.</p>
                
                <!-- Order Status Tracker Animation -->
                <div class="order-tracker">
                    <div class="tracker-step active">
                        <div class="step-dot"></div>
                        <span>Recibido</span>
                    </div>
                    <div class="tracker-step active pulse">
                        <div class="step-dot"></div>
                        <span>Embotellado</span>
                    </div>
                    <div class="tracker-step">
                        <div class="step-dot"></div>
                        <span>En Camino</span>
                    </div>
                    <div class="tracker-step">
                        <div class="step-dot"></div>
                        <span>Entregado</span>
                    </div>
                </div>

                <button class="btn btn-secondary btn-block" id="closeSuccessModal">Volver a la Tienda</button>
            </div>
        </div>
    </div>

    <!-- Mineral Chart Modal -->
    <div class="modal-overlay" id="mineralModalOverlay">
        <div class="modal-card mineral-modal-card">
            <button class="modal-close" id="mineralModalClose"><i data-lucide="x"></i></button>
            <div class="modal-header text-center">
                <span class="badge-tag" id="modalProductBadge">Insignia</span>
                <h2 id="modalProductName">AquaAura Manantial Puro</h2>
                <p id="modalProductTagline">Análisis Cuantitativo de Minerales (mg/L)</p>
            </div>
            
            <div class="mineral-visual-grid">
                <div class="ph-gauge-card">
                    <div class="ph-val" id="modalPhVal">7.8</div>
                    <div class="ph-label">pH Alcalino Neutro</div>
                    <div class="ph-bar-container">
                        <div class="ph-marker" id="modalPhMarker" style="left: 78%;"></div>
                    </div>
                    <div class="ph-scale-labels">
                        <span>Ácido (6.0)</span>
                        <span>Neutro (7.0)</span>
                        <span>Alcalino (8.5)</span>
                    </div>
                </div>

                <div class="mineral-bars-wrapper" id="modalBarsWrapper"></div>
            </div>

            <div class="mineral-desc-box">
                <p id="modalProductDesc"></p>
            </div>
        </div>
    </div>

    <!-- Lucide Icon Initialization -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
    <script src="/js/main.js"></script>
</body>
